# Data Source Configuration

# Query timeout (seconds)
QUERY_TIMEOUT_SECONDS=600

# ClickHouse (also used for CHG production planning data)
CLICKHOUSE_HOST=135.237.184.199
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# CHG Planning Settings
CHG_PLANNING_WEEK_DAYS=7
CHG_GF_DEDICATED_LINE=LINE-DUN-B

# PostgreSQL (for postgres data sources)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=insightforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# SAP Datasphere
SAP_ODATA_URL=https://your-tenant.datasphere.cloud.sap
SAP_DATASPHERE_SPACE_ID=PP
SAP_OAUTH_TOKEN_URL=https://tenant.authentication.region.hana.ondemand.com/oauth/token
SAP_CLIENT_ID=your-client-id
SAP_CLIENT_SECRET=your-client-secret

# Azure Key Vault (SAP token storage)
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/

# Logging
LOG_LEVEL=INFO

# LLM — unified client routes by model name (claude* → Claude, else → Azure/OpenAI)
# Claude (use CLAUDE_API_KEY or ANTHROPIC_API_KEY)
CLAUDE_API_KEY=your-claude-or-anthropic-api-key
CLAUDE_ENDPOINT=
# Custom Claude base URL (e.g. proxy); if set, uses AnthropicFoundry. Example: https://your-gateway.example.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Azure OpenAI (for gpt-4o etc.; route when model does not contain "claude")
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# OpenAI (fallback when Azure not set)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# API Settings
# DEBUG=True
# API_TITLE=InsightForge Analytics API
# API_VERSION=1.0.0

# Azure OpenAI Settings (REQUIRED)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-turbo
AZURE_OPENAI_TEMPERATURE=0.0
AZURE_OPENAI_MAX_TOKENS=4000

# ClickHouse Settings
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_POOL_SIZE=10

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_TTL=3600

# SAP Datasphere Settings
SAP_ODATA_URL=https://3f8448f3.us10.hcs.cloud.sap
SAP_DATASPHERE_SPACE_ID=PP
# SAP_OAUTH_TOKEN_URL=https://tenant.authentication.region.hana.ondemand.com/oauth/token
# SAP_CLIENT_ID=your-client-id
# SAP_CLIENT_SECRET=your-client-secret

# PostgreSQL (data source config)
# The database must exist on the server. Create it if missing: createdb <POSTGRES_DATABASE>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=insightforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# LangGraph Settings
LANGGRAPH_MAX_ITERATIONS=50
LANGGRAPH_DEBUG=False

# Observability Settings
OTEL_SERVICE_NAME=analytics-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
